#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = D:\VisualStudio\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe --regenerate-during-build -SD:\iGame\LabViewer-sub -BD:\iGame\LabViewer-sub\out\build\x64-Debug
  description = Re-running CMake...
  generator = 1


